<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Orkyo.Community.Seed</RootNamespace>
    <AssemblyName>Orkyo.Community.Seed</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <!-- Shared config keys and single-tenant defaults. Orkyo.Community is a Web SDK
       library, so a ProjectReference would pull ASP.NET into this CLI; link the files. -->
  <ItemGroup>
    <Compile Include="..\..\src\CommunityConfigKeys.cs" Link="CommunityConfigKeys.cs" />
    <Compile Include="..\..\src\Tenant\SingleTenantOptions.cs" Link="SingleTenantOptions.cs" />
  </ItemGroup>

  <!-- Foundation Seed library: project reference locally, NuGet when sibling not present. -->
  <Choose>
    <When Condition="Exists('..\..\..\..\orkyo-foundation\backend\seeding\Orkyo.Foundation.Seed.csproj')">
      <ItemGroup>
        <ProjectReference Include="..\..\..\..\orkyo-foundation\backend\seeding\Orkyo.Foundation.Seed.csproj" />
      </ItemGroup>
    </When>
    <Otherwise>
      <ItemGroup>
        <PackageReference Include="Orkyo.Foundation.Seed" />
      </ItemGroup>
    </Otherwise>
  </Choose>
</Project>
