# Local development build — uses foundation sibling source via project references.
# Context: parent directory (../) — no GHCR_TOKEN required.
# For the production/CI build see: Dockerfile
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Restore layer: version lists, NuGet config and project files ONLY. Source is copied
# after the restore below, so editing code does not invalidate it — the same shape the
# CI Dockerfile uses, and the cache the dev loop leans on hardest.
COPY orkyo-foundation/Directory.Build.props    orkyo-foundation/
COPY orkyo-foundation/Directory.Packages.props  orkyo-foundation/
COPY orkyo-foundation/nuget.config              orkyo-foundation/
COPY orkyo-community/Directory.Packages.props  orkyo-community/
COPY orkyo-community/Directory.Build.props     orkyo-community/
COPY orkyo-community/nuget.config              orkyo-community/
COPY orkyo-community/backend/migrations/Orkyo.Community.Migrations.csproj  orkyo-community/backend/migrations/
COPY orkyo-community/backend/src/Orkyo.Community.csproj  orkyo-community/backend/src/
COPY orkyo-community/backend/worker/Orkyo.Community.Worker.csproj  orkyo-community/backend/worker/
COPY orkyo-foundation/backend/core/Orkyo.Foundation.Core.csproj  orkyo-foundation/backend/core/
COPY orkyo-foundation/backend/migration-abstractions/Orkyo.Migration.Abstractions.csproj  orkyo-foundation/backend/migration-abstractions/
COPY orkyo-foundation/backend/migrations-foundation/Orkyo.Foundation.Migrations.csproj  orkyo-foundation/backend/migrations-foundation/
COPY orkyo-foundation/backend/migrator-runtime/Orkyo.Migrator.csproj  orkyo-foundation/backend/migrator-runtime/
COPY orkyo-foundation/backend/shared/Orkyo.Shared.csproj  orkyo-foundation/backend/shared/
COPY orkyo-foundation/backend/src/Orkyo.Foundation.Web.csproj  orkyo-foundation/backend/src/

RUN dotnet restore orkyo-community/backend/worker/Orkyo.Community.Worker.csproj

# Source last: an edit invalidates only this layer and the publish that follows.
COPY orkyo-foundation/backend/shared                  orkyo-foundation/backend/shared/
COPY orkyo-foundation/backend/core                    orkyo-foundation/backend/core/
COPY orkyo-foundation/backend/src                     orkyo-foundation/backend/src/
COPY orkyo-foundation/backend/migration-abstractions  orkyo-foundation/backend/migration-abstractions/
COPY orkyo-foundation/backend/migrator-runtime        orkyo-foundation/backend/migrator-runtime/
COPY orkyo-foundation/backend/migrations-foundation   orkyo-foundation/backend/migrations-foundation/
COPY orkyo-community/backend/migrations  orkyo-community/backend/migrations/
COPY orkyo-community/backend/src         orkyo-community/backend/src/
COPY orkyo-community/backend/worker      orkyo-community/backend/worker/

RUN dotnet publish orkyo-community/backend/worker/Orkyo.Community.Worker.csproj -c Release -o /app/publish --no-restore

# Runtime stage — identical to Dockerfile (production)
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
COPY --from=build /app/publish .

RUN useradd -r -u 999 -s /bin/false appuser \
    && chown -R appuser:appuser /app
USER appuser

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD pgrep -f Orkyo.Community.Worker.dll || exit 1

ENTRYPOINT ["dotnet", "Orkyo.Community.Worker.dll"]
