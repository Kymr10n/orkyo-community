<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Orkyo.Community.Worker</AssemblyName>
    <RootNamespace>Orkyo.Community.Worker</RootNamespace>
  </PropertyGroup>

  <!-- Foundation: project reference locally, NuGet in CI/Docker -->
  <Choose>
    <When Condition="'$(OrkyoUseFoundationPackage)' != 'true' AND Exists('..\..\..\orkyo-foundation\backend\core\Orkyo.Foundation.Core.csproj')">
      <ItemGroup>
        <ProjectReference Include="..\..\..\orkyo-foundation\backend\core\Orkyo.Foundation.Core.csproj" />
      </ItemGroup>
    </When>
    <Otherwise>
      <ItemGroup>
        <PackageReference Include="Orkyo.Foundation.Core" />
      </ItemGroup>
    </Otherwise>
  </Choose>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.Console" />
  </ItemGroup>
</Project>
