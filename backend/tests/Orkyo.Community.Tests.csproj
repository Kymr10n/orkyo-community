<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>Orkyo.Community.Tests</RootNamespace>
    <AssemblyName>Orkyo.Community.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="AwesomeAssertions" />
    <Using Include="Orkyo.Foundation.TestSupport" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="GitHubActionsTestLogger" />
    <ProjectReference Include="..\api\Orkyo.Community.Api.csproj" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <!--
      Transitive security pin, not a dependency this project uses directly. Testcontainers
      pulls SSH.NET, and every version <= 2025.1.0 carries GHSA-q939-rpr3-3284 (High).
      Testcontainers has no release referencing the patched 2026.0.0 yet, so the version is
      forced here. Same pin as foundation and saas - drop all three once
      Testcontainers.PostgreSql resolves 2026.0.0 or later on its own.
    -->
    <PackageReference Include="SSH.NET" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <!-- Foundation test support: project reference locally, NuGet in CI/Docker -->
  <Choose>
    <When Condition="'$(OrkyoUseFoundationPackage)' != 'true' AND Exists('..\..\..\orkyo-foundation\backend\testsupport\Orkyo.Foundation.TestSupport.csproj')">
      <ItemGroup>
        <ProjectReference Include="..\..\..\orkyo-foundation\backend\testsupport\Orkyo.Foundation.TestSupport.csproj" />
      </ItemGroup>
    </When>
    <Otherwise>
      <ItemGroup>
        <PackageReference Include="Orkyo.Foundation.TestSupport" />
      </ItemGroup>
    </Otherwise>
  </Choose>
</Project>
