<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Orkyo.Community.Tests</RootNamespace>
    <AssemblyName>Orkyo.Community.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="AwesomeAssertions" />
    <Using Include="Orkyo.Foundation.TestSupport" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="GitHubActionsTestLogger" Version="3.0.4" />
    <ProjectReference Include="..\api\Orkyo.Community.Api.csproj" />
    <PackageReference Include="AwesomeAssertions" Version="9.4.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.13.0" />
    <!--
      Transitive security pin, not a dependency this project uses directly. Testcontainers
      pulls SSH.NET, and every version <= 2025.1.0 carries GHSA-q939-rpr3-3284 (High).
      Testcontainers has no release referencing the patched 2026.0.0 yet, so the version is
      forced here. Same pin as foundation and saas - drop all three once
      Testcontainers.PostgreSql resolves 2026.0.0 or later on its own.
    -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
  </ItemGroup>

  <!-- Foundation test support: project reference locally, NuGet in CI/Docker -->
  <Choose>
    <When Condition="'$(OrkyoUseFoundationPackage)' != 'true' AND Exists('..\..\..\orkyo-foundation\backend\testsupport\Orkyo.Foundation.TestSupport.csproj')">
      <ItemGroup>
        <ProjectReference Include="..\..\..\orkyo-foundation\backend\testsupport\Orkyo.Foundation.TestSupport.csproj" />
      </ItemGroup>
    </When>
    <Otherwise>
      <ItemGroup>
        <PackageReference Include="Orkyo.Foundation.TestSupport" Version="$(OrkyoFoundationVersion)" />
      </ItemGroup>
    </Otherwise>
  </Choose>
</Project>
