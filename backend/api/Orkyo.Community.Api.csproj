<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Orkyo.Community.Api</RootNamespace>
    <AssemblyName>Orkyo.Community.Api</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\Orkyo.Community.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" />
    <!-- Serilog + Loki sink, JwtBearer, and Swashbuckle come transitively from Orkyo.Foundation. -->
    <!-- Program.cs builds the IConnectionMultiplexer for Valkey directly. -->
    <PackageReference Include="StackExchange.Redis" />
  </ItemGroup>
</Project>
