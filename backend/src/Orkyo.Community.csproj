<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Orkyo.Community</RootNamespace>
    <AssemblyName>Orkyo.Community</AssemblyName>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <!-- Foundation: project reference locally, NuGet in CI/Docker -->
  <Choose>
    <When Condition="'$(OrkyoUseFoundationPackage)' != 'true' AND Exists('..\..\..\orkyo-foundation\backend\src\Orkyo.Foundation.Web.csproj')">
      <ItemGroup>
        <ProjectReference Include="..\..\..\orkyo-foundation\backend\src\Orkyo.Foundation.Web.csproj" />
        <ProjectReference Include="..\..\..\orkyo-foundation\backend\migration-abstractions\Orkyo.Migration.Abstractions.csproj" />
        <ProjectReference Include="..\..\..\orkyo-foundation\backend\migrator-runtime\Orkyo.Migrator.csproj" />
        <ProjectReference Include="..\..\..\orkyo-foundation\backend\migrations-foundation\Orkyo.Foundation.Migrations.csproj" />
        <ProjectReference Include="..\migrations\Orkyo.Community.Migrations.csproj" />
      </ItemGroup>
    </When>
    <Otherwise>
      <ItemGroup>
        <PackageReference Include="Orkyo.Foundation.Web" />
        <PackageReference Include="Orkyo.Migration.Abstractions" />
        <PackageReference Include="Orkyo.Migrator" />
        <PackageReference Include="Orkyo.Foundation.Migrations" />
        <ProjectReference Include="..\migrations\Orkyo.Community.Migrations.csproj" />
      </ItemGroup>
    </Otherwise>
  </Choose>
</Project>
