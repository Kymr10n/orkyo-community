{
  "name": "orkyo-community-frontend",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": "24.x",
    "npm": "10.x"
  },
  "scripts": {
    "postinstall": "node scripts/sync-foundation-build.mjs && node scripts/check-foundation-peers.mjs",
    "dev": "vite --host 0.0.0.0 --port 5173",
    "prebuild": "cp -r node_modules/@kymr10n/foundation/assets/. public/",
    "build": "vite build",
    "check:foundation-imports": "node ./scripts/validate-foundation-imports.mjs",
    "check:dedupe-sync": "node ./scripts/check-dedupe-sync.mjs",
    "check:knip": "knip --no-progress",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
