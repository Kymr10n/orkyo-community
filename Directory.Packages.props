<Project>
  <!--
    Central package management: every NuGet version for this repo lives here.
    Projects reference packages without a Version attribute. Third-party
    versions mirror orkyo-foundation's Directory.Packages.props; Orkyo.*
    packages ride $(OrkyoFoundationVersion) from Directory.Build.props, which
    scripts/bump-foundation.sh continues to rewrite.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Orkyo foundation packages (used by the CI/Docker package path) -->
  <ItemGroup>
    <PackageVersion Include="Orkyo.Foundation.Core" Version="$(OrkyoFoundationVersion)" />
    <PackageVersion Include="Orkyo.Foundation.Hosting" Version="$(OrkyoFoundationVersion)" />
    <PackageVersion Include="Orkyo.Foundation.Migrations" Version="$(OrkyoFoundationVersion)" />
    <PackageVersion Include="Orkyo.Foundation.Seed" Version="$(OrkyoFoundationVersion)" />
    <PackageVersion Include="Orkyo.Foundation.TestSupport" Version="$(OrkyoFoundationVersion)" />
    <PackageVersion Include="Orkyo.Foundation.Web" Version="$(OrkyoFoundationVersion)" />
    <PackageVersion Include="Orkyo.Migration.Abstractions" Version="$(OrkyoFoundationVersion)" />
    <PackageVersion Include="Orkyo.Migrator" Version="$(OrkyoFoundationVersion)" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="StackExchange.Redis" Version="3.3.1" />
    <!-- Transitive via Orkyo.Foundation (MailKit/MimeKit and ASP.NET DataProtection).
         Pinned to the first release outside the 2026-10-13 advisories (<= 10.0.12):
         GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7, GHSA-7hqp-7c5m-4vq6, GHSA-c399-9853-6jmj,
         GHSA-r955-8q5j-3h83. Remove once the upstream packages raise their floors. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>

  <!-- Test-only -->
  <ItemGroup>
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="GitHubActionsTestLogger" Version="3.0.5" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
