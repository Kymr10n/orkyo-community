# Orkyo Community — Environment Configuration
#
# Easiest path: run `./generate-env.sh`. It asks for your public URL, generates
# the five secrets, and writes a complete .env.
#
# For CLI deploys: copy to .env and edit, then `docker compose up -d`.
# For Portainer:   not used; set these as stack environment variables.
#
# Vars marked REQUIRED have no default — compose will refuse to start without
# them. Commented-out vars are optional; each one states what it falls back to.

# ── Version ───────────────────────────────────────────────────────────────────
# REQUIRED. Image tag to deploy. Stamped to the bundled release version when
# shipped via the GH release ZIP. To upgrade: change this value, then
# `docker compose pull && docker compose up -d` (see docs/OPERATIONS.md).
ORKYO_VERSION=CHANGE_ME_VERSION

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=orkyo
POSTGRES_PASSWORD=                 # REQUIRED — set a strong password
POSTGRES_DB=orkyo_community
KEYCLOAK_DB=keycloak

# ── Valkey ─────────────────────────────────────────────────────────────────────
VALKEY_PASSWORD=                    # REQUIRED — set a strong password

# ── Encryption ────────────────────────────────────────────────────────────────
# REQUIRED. AES-256-GCM master key for at-rest field/blob encryption (base64,
# 32 bytes). The backend fails fast if unset/invalid. Generate once and keep it
# stable — rotating it makes existing encrypted data unreadable.
#   openssl rand -base64 32
ORKYO_MASTER_ENCRYPTION_KEY=

# ── Public URLs ───────────────────────────────────────────────────────────────
# REQUIRED. Public URL where users reach the app (no trailing slash).
# This is the only value you must supply yourself. KEYCLOAK_URL, the BFF
# settings and CORS all derive from it.
APP_BASE_URL=                      # e.g. https://community.example.com

# Optional. Defaults to APP_BASE_URL + /auth — the frontend container proxies
# /auth/ to Keycloak, so no second domain is needed (this is the layout release
# CI smoke-tests). Set it only for a dedicated auth domain, proxied to
# KEYCLOAK_PORT.
# KEYCLOAK_URL=                    # e.g. https://auth.example.com

# Optional. Defaults to APP_BASE_URL.
# CORS_ALLOWED_ORIGINS=

# ── Keycloak ──────────────────────────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=           # REQUIRED — set a strong password
KEYCLOAK_REALM=orkyo-community
KEYCLOAK_BACKEND_CLIENT_ID=orkyo-backend
KEYCLOAK_BACKEND_CLIENT_SECRET=    # REQUIRED — secret for the orkyo-backend OIDC client

# ── BFF (server-side OIDC cookie flow) ────────────────────────────────────────
# Optional. Empty binds the session cookie to the exact request host, which is
# the stricter default. Set it only to share the cookie across subdomains.
# BFF_COOKIE_DOMAIN=               # e.g. community.example.com
# Optional. Empty derives the list from the host of APP_BASE_URL.
# BFF_ALLOWED_HOSTS=
# BFF_COOKIE_SECURE=true           # Set to false only for HTTP-only local testing

# ── Email (optional) ──────────────────────────────────────────────────────────
# With no SMTP_HOST the app does not send mail: it writes each message to the
# API log instead, invitation links included. That is fine for evaluation — see
# docs/QUICKSTART.md before you use it on a reachable host.
#
# Setting SMTP_HOST makes the rest of this block required: a half-filled block
# is a startup error rather than a guess at your port or sender.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USE_SSL=false
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=                 # e.g. noreply@example.com
# SMTP_FROM_NAME=Orkyo Community

# ── Community tenant (rarely changed) ────────────────────────────────────────
COMMUNITY__TENANTID=00000000-0000-0000-0000-000000000001
COMMUNITY__TENANTSLUG=community
COMMUNITY__TENANTNAME=Orkyo Community

# ── Observability (optional) ──────────────────────────────────────────────────
# METRICS_TOKEN=                   # Optional — enables the Prometheus /metrics endpoint
                                   #   (Basic auth: user "prometheus", password = this token).
                                   #   Leave unset to keep /metrics off entirely (404).

# ── TLS in the stack (optional) ───────────────────────────────────────────────
# Set COMPOSE_PROFILES=tls to run the bundled Caddy terminator. Caddy needs host
# ports 80 and 443, so move the frontend behind it with the two port overrides
# below (bind 127.0.0.1, port 8081). Requires an https:// APP_BASE_URL. Leave all
# of this unset when a proxy of your own already terminates TLS.
# COMPOSE_PROFILES=tls

# ── Optional port overrides ───────────────────────────────────────────────────
# FRONTEND_BIND=0.0.0.0            # use 127.0.0.1 with the tls profile
# FRONTEND_PORT=80                 # use 8081 with the tls profile
# API_PORT=8080
# KEYCLOAK_PORT=9080
