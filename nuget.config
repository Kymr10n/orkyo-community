<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Repo-authoritative: `<clear />` drops user- and machine-level sources so restore is
         deterministic everywhere, and Central Package Management requires every configured
         source to be mapped (NU1507) — a developer's personal feed would otherwise break
         restore on their machine alone.

         `github` is declared here rather than left to be injected. actions/setup-dotnet
         writes its source into a config in the workspace PARENT directory, which `<clear />`
         discards before restore sees it; declaring the feed here is what makes the CI
         restore of Orkyo.* work at all. Declaring it also means setup-dotnet reuses this
         entry instead of inventing a second name, so there is exactly one name to map.

         No credentials here on purpose: they are supplied at restore time (BuildKit secret
         in the Dockerfiles, NUGET_AUTH_TOKEN in CI). An unauthenticated entry is harmless
         because the mapping below routes only Orkyo.* to it, and local builds resolve those
         through sibling project references, never from the feed. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="github" value="https://nuget.pkg.github.com/Kymr10n/index.json" />
  </packageSources>
  <!-- Source mapping is required under CPM, and is a supply-chain control in its own right:
       a public package can never be shadowed by the private feed, and vice versa. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="github">
      <package pattern="Orkyo.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
