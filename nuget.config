<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Only nuget.org here. The GitHub Packages source is added dynamically:
       - In Dockerfiles: via `dotnet nuget add source` when nuget_token secret is present
       - In CI workflows: via `dotnet nuget add source` step before restore
       This avoids NuGet rejecting an absent/empty credential at startup. -->
  <packageSources>
    <!-- Repo-authoritative: drop any user- or machine-level sources so restore is
         deterministic everywhere. With Central Package Management every configured
         source must be mapped (NU1507), and a developer's personal feed would
         otherwise break restore on their machine alone. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <!-- Central Package Management requires every source to be mapped (NU1507). The
       GitHub Packages source is added dynamically and lands under two different names:
       `github` from the Dockerfiles (added there with an explicit name) and
       `Source` from actions/setup-dotnet's `source-url`. Both are mapped so restore
       works on either path; a mapping for a source that is not configured is inert,
       which keeps local builds on nuget.org alone working. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="github">
      <package pattern="Orkyo.*" />
    </packageSource>
    <packageSource key="Source">
      <package pattern="Orkyo.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
