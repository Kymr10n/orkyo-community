<Project>
  <PropertyGroup>
    <OrkyoFoundationVersion Condition="'$(OrkyoFoundationVersion)' == ''">0.17.1-nightly.20260814.093cb22</OrkyoFoundationVersion>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Identical in every project in this repo, so they live here rather than being
         restated in each csproj. A project that genuinely differs can still override
         any of them locally. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
